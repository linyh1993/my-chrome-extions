{
  "manifest_version": 3,
  "name": "X Traffic Mirror",
  "version": "2.0.0",
  "description": "Mirror X GraphQL and WebSocket traffic to a local endpoint.",
  "permissions": ["storage", "debugger", "tabs"],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X Traffic Mirror",
    "default_popup": "ui/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
