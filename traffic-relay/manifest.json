{
  "manifest_version": 3,
  "name": "流量镜像",
  "version": "1.5",
  "description": "按站点将 API 流量镜像到本地；支持可隐藏的悬浮面板与侧边栏控制。",
  "permissions": [
    "debugger",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开流量镜像侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "*://*.x.com/*",
    "*://x.com/*",
    "*://*.twitter.com/*",
    "*://twitter.com/*",
    "*://www.sif.com/*",
    "*://*.sif.com/*",
    "*://sif.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://x.com/*",
        "*://*.twitter.com/*",
        "*://twitter.com/*",
        "*://www.sif.com/*",
        "*://*.sif.com/*",
        "*://sif.com/*"
      ],
      "js": ["sites-config.js", "ui-state.js", "content.js"],
      "css": ["style.css"]
    }
  ]
}
