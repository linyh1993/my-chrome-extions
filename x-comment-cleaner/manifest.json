{
  "manifest_version": 3,
  "name": "X 垃圾评论拦截助手 (X Spam Reply Cleaner)",
  "version": "2.0.0",
  "description": "智能拦截、64位SimHash话术识别、8大分类词库与一键原生拉黑 X (Twitter) 帖子下方的黄推、引流号与诈骗 Bot。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "X 垃圾评论拦截助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "shared/packs.js",
        "shared/simhash.js",
        "shared/heuristics.js",
        "shared/rules.js",
        "content/x-adapter.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
